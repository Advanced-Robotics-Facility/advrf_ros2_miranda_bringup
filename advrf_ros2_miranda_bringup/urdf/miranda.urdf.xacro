<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="miranda">
  <!-- Import miranda urdf file -->
  <xacro:include filename="miranda.urdf" />

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="libecat_system.so" name="advrf_ros2_gazebo::EcatSystem">
      <ros_namespace>/advrf/miranda/ecat</ros_namespace>
      <joint>
        <name>yaw_1</name>
        <id>11</id>
        <effort_limit>460.0</effort_limit>
      </joint>
      <joint>
        <name>pitch_1</name>
        <id>12</id>
        <effort_limit>460.0</effort_limit>
      </joint>
      <joint>
        <name>yaw_2</name>
        <id>13</id>
        <effort_limit>314.0</effort_limit>
      </joint>
      <joint>
        <name>pitch_2</name>
        <id>14</id>
        <effort_limit>460.0</effort_limit>
      </joint>
      <joint>
        <name>yaw_3</name>
        <id>15</id>
        <effort_limit>314.0</effort_limit>
      </joint>
      <joint>
        <name>pitch_3</name>
        <id>16</id>
        <effort_limit>314.0</effort_limit>
      </joint>
      <joint>
        <name>dagana_A_claw_joint</name>
        <id>302</id>
        <effort_limit>1000.0</effort_limit>
      </joint>
    </plugin>
  </gazebo>
</robot>
