<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="miranda">
  <!-- Import miranda urdf file -->
  <xacro:include filename="miranda.urdf" />

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="libjoint_feedback.so" name="gazebo::JointFeedback">
      <joint_name>yaw_1</joint_name>
    </plugin>
  </gazebo>
</robot>
