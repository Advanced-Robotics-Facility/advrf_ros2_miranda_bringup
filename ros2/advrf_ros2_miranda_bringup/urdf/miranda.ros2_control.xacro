<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="miranda_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="yaw_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['yaw_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="pitch_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="yaw_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['yaw_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="pitch_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="yaw_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['yaw_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="pitch_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="dagana_A_claw_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['dagana_A_claw_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
